# Generate secure local credentials: python3 manage.py init
DATABASE_PATH=data/pharmahelp.sqlite
# Sample records are inserted only into an empty store; existing data is preserved.
SEED_SAMPLE_DATA=true
STORE_ID=1
APP_USERNAME=admin
APP_PASSWORD=replace-with-a-long-random-password
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
APP_ORIGIN=http://localhost:3000
PORT=3000
# Optional: natural-language AI, bill images, and server audio.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
