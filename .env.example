# python3 manage.py init generates local settings and a secure login.
# For Render/Vercel, use the Atlas connection string instead.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=pharmahelp
STORE_ID=1
APP_USERNAME=admin
APP_PASSWORD=replace-with-a-long-random-password
# Optional: set to your public HTTPS URL if origin validation needs it.
APP_ORIGIN=http://localhost:3000
PORT=3000
# Optional: AI answers, bill image extraction, and voice recording fallback.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# Optional: use Atlas instead of the bundled MongoDB for Compose.
# COMPOSE_MONGODB_URI=mongodb+srv://user:password@cluster.example.net/?retryWrites=true&w=majority

# Set true for a read-only preview with fictional records and no database.
DEMO_MODE=false
